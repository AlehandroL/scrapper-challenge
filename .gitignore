# Documentos de trabajo y estrategia: material de planificación interno, no
# forma parte de la entrega versionada.
planes/

# Evidencia generada por scripts/check-access.sh — se acumula localmente,
# cada quien la produce desde su propia red.
evidencia/

# Los PDFs descargados no se versionan: el de prueba pesa 9,3 MB. El manifiesto
# —el mapeo id → archivo, con tamaño y hash— sí, que es la evidencia de qué se
# bajó y cuánto pesaba.
*.pdf
descargas/
# Desde el bloque 7 los documentos van a data/<fuente>/, uno por portal: con dos
# fuentes escribiendo en una sola carpeta, un manifiesto no alcanza para saber de
# cuál es cada archivo. Se ignoran los subdirectorios de data/ y no data/ entera,
# porque los .jsonl que viven ahí sí son la entrega.
data/*/

# Estado de reanudación: es de cada corrida y de cada máquina, no un entregable.
*.checkpoint.json

tmp/
node_modules/
.DS_Store
.gstack/
